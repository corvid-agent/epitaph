                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Store the SHA-256 commitment of the off-chain epitaph message.\nOwner-only. Exactly 32 bytes. The message itself never touches the chain; only its hash does, so a future reveal is verifiable without making the farewell public before its time.",
            "events": [],
            "recommendations": {}
        },
        {
