                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Arm the switch (or re-arm it) with a fresh timeout.\nOwner-only. Sets the timeout, records the check-in round as now, and clears `published` so a re-arm after publication resurrects the switch for another silence window. The message is not stored on-chain  set its commitment separately via `commit`.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "commit",
            "args": [
                {
                    "type": "byte[32]",
                    "name": "commitment"
