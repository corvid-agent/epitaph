            "desc": "Reset the dead-man's timer. Owner-only.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "publish",
            "args": [],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Arcron hook. Zero arguments; the selector is the only app arg.\nReturns 1 the round the switch fires, 0 on every no-work path. FAIL SOFT: after the two authorization asserts nothing here may reject  a failing hook gets exponentially backed off by keeper bots and burns upkeep escrow on retries.\nNot armed (timeout 0), not yet expired, or already published: all return 0. On expiry: set published = 1, record revealed_round, return 1. One execution, permanent, readable off any indexer.",
            "events": [],
            "recommendations": {}
        },
